# ===== 基础 =====
# Neon Postgres 连接串（带 sslmode=require）
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# 站点公开地址（不带末尾斜杠）
NEXT_PUBLIC_SITE_URL=https://xiuyuknit.com

# ===== 后台管理员（单账号） =====
ADMIN_EMAIL=admin@xiuyuknit.com
# 用 npm run admin:hash -- "密码" 生成
ADMIN_PASSWORD_HASH=
# 32 字节以上随机字符串，用于签名登录 Cookie（openssl rand -base64 48）
ADMIN_SESSION_SECRET=
# base64 编码的 32 字节密钥，用于加密接入向导保存的第三方密钥（openssl rand -base64 32）
CONFIG_ENCRYPTION_KEY=

# ===== 定时任务 =====
# Vercel Cron 与外部调度器请求头 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ===== Cloudflare R2（S3 兼容对象存储） =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 桶的公开访问域名（不带末尾斜杠），例如 https://media.xiuyuknit.com
R2_PUBLIC_BASE_URL=

# ===== 询盘通知 =====
# 飞书自定义机器人 Webhook URL（在飞书群聊中添加自定义机器人获取）
FEISHU_WEBHOOK_URL=
# QQ 邮箱 SMTP 授权码（QQ邮箱→设置→账户→开启SMTP→获取授权码）
QQ_EMAIL=3293958@qq.com
QQ_AUTH_CODE=
# 接收询盘通知的邮箱
NOTIFY_EMAIL_TO=3293958@qq.com

# ===== 可选 =====
# GA4 Measurement ID（前台注入），也可在接入向导中填写后写入数据库
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
